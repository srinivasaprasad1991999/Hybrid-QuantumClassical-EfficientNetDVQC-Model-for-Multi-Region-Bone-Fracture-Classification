def train_one_seed(seed):

    print("\n", flush=True)
    print("=" * 80, flush=True)
    print(f"STARTING SEED {seed}", flush=True)
    print("=" * 80, flush=True)

    seed_start_time = time.time()

    # --------------------------------------------------------
    # Set seed
    # --------------------------------------------------------
    set_seed(seed)

    # --------------------------------------------------------
    # DataLoaders
    # --------------------------------------------------------
    print(f"Seed {seed}: creating DataLoaders...", flush=True)

    train_loader, val_loader, test_loader = create_dataloaders(seed)

    print(
        f"Seed {seed}: DataLoaders ready | "
        f"Train batches={len(train_loader)}, "
        f"Val batches={len(val_loader)}, "
        f"Test batches={len(test_loader)}",
        flush=True
    )

    # --------------------------------------------------------
    # Paths
    # --------------------------------------------------------
    checkpoint_path = get_checkpoint_path(seed)
    completion_path = get_completion_path(seed)

    result_file = os.path.join(
        SEED_RESULTS_DIR,
        f"seed_{seed}_results.json"
    )

    # --------------------------------------------------------
    # If seed already completed
    # --------------------------------------------------------
    if os.path.exists(completion_path) and os.path.exists(result_file):

        print(
            f"\nSeed {seed} is already completed.",
            flush=True
        )

        print(
            "Loading saved seed results and skipping retraining.",
            flush=True
        )

        with open(result_file, "r") as f:
            return json.load(f)

    # --------------------------------------------------------
    # Create NEW model for every seed
    # --------------------------------------------------------
    print(
        f"Seed {seed}: creating EfficientNet-B0 model...",
        flush=True
    )

    model = EfficientNet_NonlinearMLP().to(device)

    print(
        f"Seed {seed}: model created successfully.",
        flush=True
    )

    # All layers trainable
    for param in model.parameters():
        param.requires_grad = True

    # --------------------------------------------------------
    # Loss
    # --------------------------------------------------------
    criterion = nn.BCEWithLogitsLoss()

    # --------------------------------------------------------
    # Optimizer
    # --------------------------------------------------------
    optimizer = optim.Adam(
        model.parameters(),
        lr=LEARNING_RATE
    )

    # --------------------------------------------------------
    # Scheduler
    # --------------------------------------------------------
    scheduler = torch.optim.lr_scheduler.StepLR(
        optimizer,
        step_size=3,
        gamma=0.1
    )

    # --------------------------------------------------------
    # History
    # --------------------------------------------------------
    train_losses = []
    val_losses = []

    train_accs = []
    val_accs = []

    best_val_loss = float("inf")
    start_epoch = 0
    previous_elapsed_time = 0.0

    # --------------------------------------------------------
    # Resume checkpoint
    # --------------------------------------------------------
    if os.path.exists(checkpoint_path):

        print(
            f"\nCheckpoint found for Seed {seed}.",
            flush=True
        )

        print(
            "Loading checkpoint...",
            flush=True
        )

        checkpoint = safe_torch_load(checkpoint_path)

        model.load_state_dict(
            checkpoint["model_state_dict"]
        )

        optimizer.load_state_dict(
            checkpoint["optimizer_state_dict"]
        )

        scheduler.load_state_dict(
            checkpoint["scheduler_state_dict"]
        )

        train_losses = checkpoint.get(
            "train_losses",
            []
        )

        val_losses = checkpoint.get(
            "val_losses",
            []
        )

        train_accs = checkpoint.get(
            "train_accs",
            []
        )

        val_accs = checkpoint.get(
            "val_accs",
            []
        )

        best_val_loss = checkpoint.get(
            "best_val_loss",
            float("inf")
        )

        start_epoch = checkpoint.get(
            "epoch",
            0
        )

        previous_elapsed_time = checkpoint.get(
            "elapsed_time",
            0.0
        )

        print(
            f"Resuming Seed {seed} from "
            f"Epoch {start_epoch + 1}/{EPOCHS}",
            flush=True
        )

    else:

        print(
            f"\nNo checkpoint found for Seed {seed}.",
            flush=True
        )

        print(
            f"Starting Seed {seed} from Epoch 1.",
            flush=True
        )

    # --------------------------------------------------------
    # If checkpoint says all epochs are done but completion
    # marker/result is missing, continue directly to evaluation.
    # --------------------------------------------------------
    if start_epoch >= EPOCHS:

        print(
            f"Seed {seed}: all {EPOCHS} epochs are already "
            f"present in the checkpoint.",
            flush=True
        )

    # --------------------------------------------------------
    # TRAINING LOOP
    # --------------------------------------------------------
    for epoch in range(
        start_epoch,
        EPOCHS
    ):

        epoch_start_time = time.time()

        print("\n", flush=True)
        print(
            "=" * 80,
            flush=True
        )
        print(
            f"SEED {seed} | EPOCH {epoch + 1}/{EPOCHS} | "
            f"STARTING TRAINING",
            flush=True
        )
        print(
            "=" * 80,
            flush=True
        )

        # ====================================================
        # TRAIN
        # ====================================================

        model.train()

        running_loss = 0.0
        correct = 0
        total = 0

        batch_start_time = time.time()

        progress = tqdm(
            train_loader,
            total=len(train_loader),
            desc=f"Seed {seed} | Epoch {epoch + 1}/{EPOCHS}",
            unit="batch",
            dynamic_ncols=True,
            leave=True
        )

        for batch_idx, (images, labels) in enumerate(progress):

            images = images.to(
                device,
                non_blocking=True
            )

            labels = (
                labels
                .float()
                .unsqueeze(1)
                .to(
                    device,
                    non_blocking=True
                )
            )

            # Clear gradients
            optimizer.zero_grad(
                set_to_none=True
            )

            # ------------------------------------------------
            # Forward
            # ------------------------------------------------
            outputs = model(images)

            # BCEWithLogitsLoss
            loss = criterion(
                outputs,
                labels
            )

            # ------------------------------------------------
            # Backpropagation
            # ------------------------------------------------
            loss.backward()

            # ------------------------------------------------
            # Update
            # ------------------------------------------------
            optimizer.step()

            running_loss += loss.item()

            # ------------------------------------------------
            # Training accuracy
            # ------------------------------------------------
            probs = torch.sigmoid(outputs)

            preds = (
                probs > 0.5
            ).float()

            correct += (
                preds.squeeze() ==
                labels.squeeze()
            ).sum().item()

            total += labels.size(0)

            current_loss = (
                running_loss /
                (batch_idx + 1)
            )

            current_acc = (
                correct / total
                if total > 0
                else 0
            )

            progress.set_postfix(
                loss=f"{current_loss:.4f}",
                acc=f"{current_acc * 100:.2f}%"
            )

            # Print explicit first-batch diagnostic
            if batch_idx == 0:

                first_batch_time = (
                    time.time() -
                    batch_start_time
                )

                print(
                    f"\nSeed {seed} | Epoch {epoch + 1}: "
                    f"FIRST BATCH COMPLETED in "
                    f"{first_batch_time:.2f} seconds | "
                    f"Loss={loss.item():.4f}",
                    flush=True
                )

        train_loss = (
            running_loss /
            len(train_loader)
        )

        train_acc = (
            correct / total
            if total > 0
            else 0
        )

        # ====================================================
        # VALIDATION
        # ====================================================

        print(
            f"\nSeed {seed} | Epoch {epoch + 1}: "
            f"training finished. Starting validation...",
            flush=True
        )

        val_loss, val_acc = evaluate_epoch(
            model,
            val_loader,
            criterion
        )

        print(
            f"Seed {seed} | Epoch {epoch + 1}: "
            f"validation finished.",
            flush=True
        )

        # ====================================================
        # LR SCHEDULER
        # ====================================================

        scheduler.step()

        current_lr = optimizer.param_groups[0]["lr"]

        # ====================================================
        # BEST MODEL
        # ====================================================

        if val_loss < best_val_loss:

            best_val_loss = val_loss

            best_model_path = os.path.join(
                CHECKPOINT_DIR,
                f"seed_{seed}_best_model.pth"
            )

            torch.save(
                model.state_dict(),
                best_model_path
            )

            best_status = "UPDATED"

        else:

            best_status = "NOT UPDATED"

        # ====================================================
        # STORE HISTORY
        # ====================================================

        train_losses.append(
            train_loss
        )

        val_losses.append(
            val_loss
        )

        train_accs.append(
            train_acc
        )

        val_accs.append(
            val_acc
        )

        # ====================================================
        # TIME
        # ====================================================

        epoch_time = (
            time.time() -
            epoch_start_time
        )

        elapsed_time = (
            previous_elapsed_time +
            (time.time() - seed_start_time)
        )

        # ====================================================
        # PRINT EPOCH RESULTS
        # ====================================================

        print("\n", flush=True)
        print(
            "-" * 80,
            flush=True
        )

        print(
            f"Seed {seed} | "
            f"Epoch {epoch + 1}/{EPOCHS}",
            flush=True
        )

        print(
            f"Train Loss: {train_loss:.4f} | "
            f"Val Loss: {val_loss:.4f}",
            flush=True
        )

        print(
            f"Train Accuracy: {train_acc * 100:.2f}% | "
            f"Val Accuracy: {val_acc * 100:.2f}%",
            flush=True
        )

        print(
            f"Learning Rate: {current_lr:.8f}",
            flush=True
        )

        print(
            f"Epoch Time: {epoch_time / 60:.2f} minutes",
            flush=True
        )

        print(
            f"Total Seed Time: {elapsed_time / 60:.2f} minutes",
            flush=True
        )

        print(
            f"Best Val Loss: {best_val_loss:.4f} | "
            f"Best Model: {best_status}",
            flush=True
        )

        print(
            "-" * 80,
            flush=True
        )

        # ====================================================
        # SAVE CHECKPOINT AFTER EVERY EPOCH
        # ====================================================

        checkpoint = {

            "seed":
                seed,

            "epoch":
                epoch + 1,

            "model_state_dict":
                model.state_dict(),

            "optimizer_state_dict":
                optimizer.state_dict(),

            "scheduler_state_dict":
                scheduler.state_dict(),

            "train_losses":
                train_losses,

            "val_losses":
                val_losses,

            "train_accs":
                train_accs,

            "val_accs":
                val_accs,

            "best_val_loss":
                best_val_loss,

            "elapsed_time":
                elapsed_time
        }

        temporary_checkpoint_path = (
            checkpoint_path + ".tmp"
        )

        # Atomic-ish save:
        # write temporary file first, then replace old file.
        torch.save(
            checkpoint,
            temporary_checkpoint_path
        )

        os.replace(
            temporary_checkpoint_path,
            checkpoint_path
        )

        print(
            f"Checkpoint saved successfully: "
            f"Seed {seed}, Epoch {epoch + 1}",
            flush=True
        )

        print(
            f"Checkpoint path: {checkpoint_path}",
            flush=True
        )

    # ========================================================
    # TRAINING COMPLETE
    # ========================================================

    total_seed_time = (
        previous_elapsed_time +
        (time.time() - seed_start_time)
    )

    print("\n", flush=True)
