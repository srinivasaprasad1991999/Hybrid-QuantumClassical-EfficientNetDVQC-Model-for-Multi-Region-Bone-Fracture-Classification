mean_fpr = np.linspace(
    0,
    1,
    1000
)


def calculate_mean_sd_roc(
    results,
    dataset_key
):

    all_tpr = []

    for result in results:

        fpr = np.array(
            result[
                f"{dataset_key}_fpr"
            ]
        )

        tpr = np.array(
            result[
                f"{dataset_key}_tpr"
            ]
        )

        interpolated_tpr = np.interp(
            mean_fpr,
            fpr,
            tpr
        )

        interpolated_tpr[0] = 0.0

        interpolated_tpr[-1] = 1.0

        all_tpr.append(
            interpolated_tpr
        )

    all_tpr = np.array(
        all_tpr
    )

    mean_tpr = np.mean(
        all_tpr,
        axis=0
    )

    sd_tpr = np.std(
        all_tpr,
        axis=0,
        ddof=1
    )

    return (
        mean_tpr,
        sd_tpr
    )


