def create_dataloaders(seed):

    # Generator gives reproducible shuffle for each seed
    generator = torch.Generator()

    generator.manual_seed(seed)

    train_loader = DataLoader(
        train_dataset,
        batch_size=BATCH_SIZE,
        shuffle=True,
        generator=generator,
        num_workers=0,
        pin_memory=torch.cuda.is_available(),
        persistent_workers=False
    )

    val_loader = DataLoader(
        val_dataset,
        batch_size=BATCH_SIZE,
        shuffle=False,
        num_workers=0,
        pin_memory=torch.cuda.is_available(),
        persistent_workers=False
    )

    test_loader = DataLoader(
        test_dataset,
        batch_size=BATCH_SIZE,
        shuffle=False,
        num_workers=0,
        pin_memory=torch.cuda.is_available(),
        persistent_workers=False
    )

    return train_loader, val_loader, test_loader


# ============================================================
# 13. MODEL
# ============================================================

class EfficientNet_NonlinearMLP(nn.Module):

    def __init__(self):

        super(EfficientNet_NonlinearMLP, self).__init__()

        # ----------------------------------------------------
        # EfficientNet-B0 pretrained backbone
        # ----------------------------------------------------

        self.backbone = models.efficientnet_b0(
            weights=EfficientNet_B0_Weights.DEFAULT
        )

        # ----------------------------------------------------
        # Remove original EfficientNet classifier
        # ----------------------------------------------------

        self.backbone.classifier = nn.Identity()

        # ----------------------------------------------------
        # Classical nonlinear head
        #
        # 1280 → 4 → 5 → 1
        # ----------------------------------------------------

        self.fc1 = nn.Linear(1280, 4)

        self.tanh = nn.Tanh()

        self.fc2 = nn.Linear(4, 5)

        self.relu = nn.ReLU()

        self.fc3 = nn.Linear(5, 1)

    def forward(self, x):

        # EfficientNet-B0
        x = self.backbone(x)

        # 1280 → 4
        x = self.fc1(x)

        # Tanh
        x = self.tanh(x)

        # 4 → 5
        x = self.fc2(x)

        # ReLU
        x = self.relu(x)

        # 5 → 1
        x = self.fc3(x)

        # IMPORTANT:
        # Return LOGIT.
        #
        # BCEWithLogitsLoss is used during training.
        # Sigmoid is applied only during evaluation.
        return x


