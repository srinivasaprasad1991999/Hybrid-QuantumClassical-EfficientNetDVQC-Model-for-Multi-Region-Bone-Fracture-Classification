def safe_torch_load(path):
    """
    Load checkpoints safely across different PyTorch versions.
    Newer PyTorch versions may default to weights_only=True;
    our checkpoint contains optimizer/scheduler/history objects,
    so explicitly request the complete checkpoint when supported.
    """
    try:
        return torch.load(
            path,
            map_location=device,
            weights_only=False
        )
    except TypeError:
        return torch.load(
            path,
            map_location=device
        )



def get_checkpoint_path(seed):

    return os.path.join(
        CHECKPOINT_DIR,
        f"seed_{seed}_checkpoint.pth"
    )


