# ============================================================
# 16. METRIC FUNCTION
# ============================================================

def calculate_metrics(
    y_true,
    y_pred,
    y_prob
):

    # --------------------------------------------------------
    # Confusion matrix
    # --------------------------------------------------------

    cm = confusion_matrix(
        y_true,
        y_pred,
        labels=[0, 1]
    )

    TN, FP, FN, TP = cm.ravel()


    # --------------------------------------------------------
    # Accuracy
    # --------------------------------------------------------

    accuracy = (
        (TP + TN)
        /
        (TP + TN + FP + FN)
        *
        100
    )


    # --------------------------------------------------------
    # Sensitivity / Recall
    # --------------------------------------------------------

    if (TP + FN) > 0:

        sensitivity = (
            TP / (TP + FN)
        ) * 100

    else:

        sensitivity = 0.0


    # --------------------------------------------------------
    # Specificity
    # --------------------------------------------------------

    if (TN + FP) > 0:

        specificity = (
            TN / (TN + FP)
        ) * 100

    else:

        specificity = 0.0


    # --------------------------------------------------------
    # Precision
    # --------------------------------------------------------

    precision = precision_score(
        y_true,
        y_pred,
        zero_division=0
    ) * 100


    # --------------------------------------------------------
    # F1
    # --------------------------------------------------------

    f1 = f1_score(
        y_true,
        y_pred,
        zero_division=0
    ) * 100


    # --------------------------------------------------------
    # Error rate
    # --------------------------------------------------------

    error_rate = 100 - accuracy


    # --------------------------------------------------------
    # ROC-AUC
    # --------------------------------------------------------

    try:

        auc_value = roc_auc_score(
            y_true,
            y_prob
        )

    except ValueError:

        auc_value = np.nan


    metrics = {

        "Accuracy (%)": accuracy,

        "Sensitivity (%)": sensitivity,

        "Specificity (%)": specificity,

        "Precision (%)": precision,

        "F1-Score (%)": f1,

        "Error Rate (%)": error_rate,

        "ROC-AUC": auc_value
    }


    return metrics, cm


# ============================================================
# 17. PREDICTION FUNCTION
# ============================================================

def get_predictions(
    model,
    loader
):

    model.eval()


    y_true = []

    y_pred = []

    y_prob = []


    with torch.no_grad():

        for images, labels in loader:

            images = images.to(device)


            outputs = model(images)


            # BCEWithLogitsLoss output
            probs = torch.sigmoid(outputs)


            preds = (
                probs >= 0.5
            ).long()


            y_true.extend(
                labels.cpu().numpy()
            )


            y_pred.extend(
                preds.cpu()
                .numpy()
                .flatten()
            )


            y_prob.extend(
                probs.cpu()
                .numpy()
                .flatten()
            )


    return (
        np.array(y_true),
        np.array(y_pred),
        np.array(y_prob)
    )


# ============================================================
# 18. TRAIN ONE SEED
# ============================================================

def train_one_seed(seed):

    print("\n")
    print("=" * 70)
    print(f"STARTING SEED {seed}")
    print("=" * 70)


    # --------------------------------------------------------
    # Set seed
    # --------------------------------------------------------

    set_seed(seed)


    seed_start_time = time.time()


    # --------------------------------------------------------
    # Create a NEW model
    # --------------------------------------------------------

    model = EfficientNet_FC().to(device)


    # --------------------------------------------------------
    # Loss
    # --------------------------------------------------------

    criterion = nn.BCEWithLogitsLoss()


    # --------------------------------------------------------
    # Optimizer
    # --------------------------------------------------------

    optimizer = optim.Adam(
        model.parameters(),
        lr=LEARNING_RATE
    )


    # --------------------------------------------------------
    # Scheduler
    # --------------------------------------------------------

    scheduler = torch.optim.lr_scheduler.StepLR(
        optimizer,
        step_size=3,
        gamma=0.1
    )


    # --------------------------------------------------------
    # History
    # --------------------------------------------------------

    history = {

        "train_loss": [],

        "val_loss": [],

        "train_acc": [],

        "val_acc": []
    }


    # --------------------------------------------------------
    # Best validation model
    # --------------------------------------------------------

    best_val_loss = float("inf")

    best_model_state = None


    # ========================================================
    # TRAINING LOOP
    # ========================================================

    for epoch in range(EPOCHS):


        # ====================================================
        # TRAIN
        # ====================================================

        model.train()


        running_loss = 0.0

        correct = 0

        total = 0


        for images, labels in train_loader:

            images = images.to(device)

            labels = (
                labels
                .float()
                .unsqueeze(1)
                .to(device)
            )


            optimizer.zero_grad()


            outputs = model(images)


            loss = criterion(
                outputs,
                labels
            )


            loss.backward()


            optimizer.step()


            running_loss += loss.item()


            # ------------------------------------------------
            # Training accuracy
            # ------------------------------------------------

            probs = torch.sigmoid(outputs)


            preds = (
                probs >= 0.5
            ).float()


            correct += (
                preds == labels
            ).sum().item()


            total += labels.size(0)


        # ----------------------------------------------------
        # Training statistics
        # ----------------------------------------------------

        train_loss = (
            running_loss /
            len(train_loader)
        )


        train_acc = (
            correct /
            total
        ) * 100


        # ====================================================
        # VALIDATION
        # ====================================================

        model.eval()


        val_running_loss = 0.0

        val_correct = 0

        val_total = 0


        with torch.no_grad():

            for images, labels in val_loader:

                images = images.to(device)

                labels = (
                    labels
                    .float()
                    .unsqueeze(1)
                    .to(device)
                )


                outputs = model(images)


                loss = criterion(
                    outputs,
                    labels
                )


                val_running_loss += (
                    loss.item()
                )


                probs = torch.sigmoid(
                    outputs
                )


                preds = (
                    probs >= 0.5
                ).float()


                val_correct += (
                    preds == labels
                ).sum().item()


                val_total += (
                    labels.size(0)
                )


        # ----------------------------------------------------
        # Validation statistics
        # ----------------------------------------------------

        val_loss = (
            val_running_loss /
            len(val_loader)
        )


        val_acc = (
            val_correct /
            val_total
        ) * 100


        # ----------------------------------------------------
        # Scheduler
        # ----------------------------------------------------

        scheduler.step()


        # ----------------------------------------------------
        # Save best model
        # ----------------------------------------------------

        if val_loss < best_val_loss:

            best_val_loss = val_loss


            best_model_state = copy.deepcopy(
                model.state_dict()
            )


        # ----------------------------------------------------
        # Save history
        # ----------------------------------------------------

        history["train_loss"].append(
            train_loss
        )

        history["val_loss"].append(
            val_loss
        )

        history["train_acc"].append(
            train_acc
        )

        history["val_acc"].append(
            val_acc
        )


        # ----------------------------------------------------
        # Print epoch
        # ----------------------------------------------------

        print(
            f"Seed {seed} | "
            f"Epoch {epoch + 1}/{EPOCHS} | "
            f"Train Loss: {train_loss:.4f} | "
            f"Val Loss: {val_loss:.4f} | "
            f"Train Acc: {train_acc:.2f}% | "
            f"Val Acc: {val_acc:.2f}%"
        )


    # ========================================================
    # RESTORE BEST MODEL
    # ========================================================

    model.load_state_dict(
        best_model_state
    )


    model = model.to(device)


    # ========================================================
    # SAVE BEST MODEL FOR THIS SEED
    # ========================================================

    seed_model_path = (
        f"best_fc_model_seed_{seed}.pth"
    )


    torch.save(
        model.state_dict(),
        seed_model_path
    )


    # ========================================================
    # EVALUATE TRAINING DATA
    # ========================================================

    train_y, train_pred, train_prob = (
        get_predictions(
            model,
            train_loader
        )
    )


    train_metrics, train_cm = (
        calculate_metrics(
            train_y,
            train_pred,
            train_prob
        )
    )


    # ========================================================
    # EVALUATE VALIDATION DATA
    # ========================================================

    val_y, val_pred, val_prob = (
        get_predictions(
            model,
            val_loader
        )
    )


    val_metrics, val_cm = (
        calculate_metrics(
            val_y,
            val_pred,
            val_prob
        )
    )


    # ========================================================
    # EVALUATE TEST DATA
    # ========================================================

    test_y, test_pred, test_prob = (
        get_predictions(
            model,
            test_loader
        )
    )


    test_metrics, test_cm = (
        calculate_metrics(
            test_y,
            test_pred,
            test_prob
        )
    )


    # ========================================================
    # SEED TIME
    # ========================================================

    seed_time = (
        time.time() -
        seed_start_time
    )


    seed_minutes = (
        seed_time / 60
    )


    print("\n" + "-" * 70)

    print(
        f"Seed {seed} completed."
    )

    print(
        f"Time taken for Seed {seed}: "
        f"{seed_minutes:.2f} minutes"
    )

    print(
        f"Best Validation Loss: "
        f"{best_val_loss:.4f}"
    )

    print("-" * 70)


    # ========================================================
    # RETURN EVERYTHING
    # ========================================================

    return {

        "seed": seed,

        "model": model,

        "history": history,

        "train_metrics": train_metrics,

        "val_metrics": val_metrics,

        "test_metrics": test_metrics,

        "train_cm": train_cm,

        "val_cm": val_cm,

        "test_cm": test_cm,

        "train_y": train_y,

        "train_pred": train_pred,

        "train_prob": train_prob,

        "val_y": val_y,

        "val_pred": val_pred,

        "val_prob": val_prob,

        "test_y": test_y,

        "test_pred": test_pred,

        "test_prob": test_prob,

        "time_minutes": seed_minutes,

        "model_path": seed_model_path
    }


