# 14. MODEL
#
# EfficientNet-B0
#       ↓
# 1280 features
#       ↓
# Linear(1280 → 4)
#       ↓
# Tanh
#       ↓
# Linear(4 → 1)
# ============================================================

class EfficientNet_FC(nn.Module):

    def __init__(self):

        super(EfficientNet_FC, self).__init__()


        # ----------------------------------------------------
        # EfficientNet-B0 backbone
        # ----------------------------------------------------

        self.backbone = models.efficientnet_b0(
            weights=EfficientNet_B0_Weights.DEFAULT
        )


        # ----------------------------------------------------
        # Remove original classifier
        # ----------------------------------------------------

        self.backbone.classifier = nn.Identity()


        # ----------------------------------------------------
        # Linear compression
        # 1280 → 4
        # ----------------------------------------------------

        self.fc1 = nn.Linear(
            1280,
            4
        )


        # ----------------------------------------------------
        # Nonlinear activation
        # ----------------------------------------------------

        self.act = nn.Tanh()


        # ----------------------------------------------------
        # Classical output head
        # 4 → 1
        # ----------------------------------------------------

        self.fc2 = nn.Linear(
            4,
            1
        )


    def forward(self, x):

        # EfficientNet-B0
        x = self.backbone(x)


        # 1280 → 4
        x = self.fc1(x)


        # Tanh
        x = self.act(x)


        # 4 → 1
        x = self.fc2(x)


        return x


