# ============================================================
# 11. MODEL
#
# EfficientNet-B0
#       ↓
# 1280 features
#       ↓
# Dropout(0.2)
#       ↓
# Linear(1280 → 1)
#       ↓
# Sigmoid during evaluation
# ============================================================

class EfficientNetB0Baseline(nn.Module):

    def __init__(self):

        super(EfficientNetB0Baseline, self).__init__()

        # ----------------------------------------------------
        # EfficientNet-B0 pretrained backbone
        # ----------------------------------------------------

        self.backbone = models.efficientnet_b0(
            weights=EfficientNet_B0_Weights.DEFAULT
        )

        # ----------------------------------------------------
        # Remove original classifier
        # ----------------------------------------------------

        self.backbone.classifier = nn.Identity()

        # ----------------------------------------------------
        # Dropout
        # ----------------------------------------------------

        self.dropout = nn.Dropout(
            p=0.2
        )

        # ----------------------------------------------------
        # Linear 1280 → 1
        # ----------------------------------------------------

        self.fc = nn.Linear(
            1280,
            1
        )

    def forward(self, x):

        # EfficientNet-B0 → 1280 features
        x = self.backbone(x)

        # Dropout
        x = self.dropout(x)

        # Linear 1280 → 1
        x = self.fc(x)

        # IMPORTANT:
        # No sigmoid here.
        # BCEWithLogitsLoss expects logits.

        return x


# ============================================================
# 12. METRIC FUNCTION
# ============================================================

def calculate_metrics(
    y_true,
    y_pred,
    y_prob
):

    cm = confusion_matrix(
        y_true,
        y_pred,
        labels=[0, 1]
    )

    TN, FP, FN, TP = cm.ravel()

    total = TN + FP + FN + TP

    # --------------------------------------------------------
    # Accuracy
    # --------------------------------------------------------

    accuracy = (
        (TP + TN) / total * 100
        if total > 0 else 0.0
    )

    # --------------------------------------------------------
    # Sensitivity
    # --------------------------------------------------------

    sensitivity = (
        TP / (TP + FN) * 100
        if (TP + FN) > 0 else 0.0
    )

    # --------------------------------------------------------
    # Specificity
    # --------------------------------------------------------

    specificity = (
        TN / (TN + FP) * 100
        if (TN + FP) > 0 else 0.0
    )

    # --------------------------------------------------------
    # Precision
    # --------------------------------------------------------

    precision = precision_score(
        y_true,
        y_pred,
        zero_division=0
    ) * 100

    # --------------------------------------------------------
    # F1
    # --------------------------------------------------------

    f1 = f1_score(
        y_true,
        y_pred,
        zero_division=0
    ) * 100

    # --------------------------------------------------------
    # Error Rate
    # --------------------------------------------------------

    error_rate = (
        (FP + FN) / total * 100
        if total > 0 else 0.0
    )

    # --------------------------------------------------------
    # ROC-AUC
    # --------------------------------------------------------

    if len(np.unique(y_true)) == 2:

        roc_auc = roc_auc_score(
            y_true,
            y_prob
        )

    else:

        roc_auc = np.nan

    metrics = {

        "Accuracy (%)": accuracy,

        "Sensitivity (%)": sensitivity,

        "Specificity (%)": specificity,

        "Precision (%)": precision,

        "F1-Score (%)": f1,

        "Error Rate (%)": error_rate,

        "ROC-AUC": roc_auc
    }

    return metrics, cm


# ============================================================
# 13. PREDICTION FUNCTION
# ============================================================

def get_predictions(
    model,
    loader
):

    model.eval()

    y_true = []
    y_pred = []
    y_prob = []

    with torch.no_grad():

        for images, labels in loader:

            images = images.to(
                device,
                non_blocking=True
            )

            # ------------------------------------------------
            # Model returns logits
            # ------------------------------------------------

            outputs = model(images)

            # ------------------------------------------------
            # Sigmoid ONLY during evaluation
            # ------------------------------------------------

            probs = torch.sigmoid(
                outputs
            )

            preds = (
                probs >= 0.5
            ).long()

            y_true.extend(
                labels.cpu().numpy()
            )

            y_pred.extend(
                preds.cpu()
                .numpy()
                .flatten()
            )

            y_prob.extend(
                probs.cpu()
                .numpy()
                .flatten()
            )

    return (
        np.array(y_true),
        np.array(y_pred),
        np.array(y_prob)
    )


# ============================================================
# 14. TRAIN ONE SEED
# ============================================================

def train_one_seed(seed):

    print("\n")
    print("=" * 70)
    print(f"STARTING SEED {seed}")
    print("=" * 70)

    # --------------------------------------------------------
    # Set seed
    # --------------------------------------------------------

    set_seed(seed)

    # --------------------------------------------------------
    # New model for this seed
    # --------------------------------------------------------

    model = EfficientNetB0Baseline().to(device)

    # --------------------------------------------------------
    # Loss
    # --------------------------------------------------------

    criterion = nn.BCEWithLogitsLoss()

    # --------------------------------------------------------
    # New optimizer
    # --------------------------------------------------------

    optimizer = optim.Adam(
        model.parameters(),
        lr=LEARNING_RATE
    )

    # --------------------------------------------------------
    # New scheduler
    # --------------------------------------------------------

    scheduler = torch.optim.lr_scheduler.StepLR(
        optimizer,
        step_size=3,
        gamma=0.1
    )

    # --------------------------------------------------------
    # History
    # --------------------------------------------------------

    history = {

        "train_loss": [],

        "val_loss": [],

        "train_acc": [],

        "val_acc": []
    }

    # --------------------------------------------------------
    # Best model
    # --------------------------------------------------------

    best_val_loss = float("inf")

    best_model_state = None

    # --------------------------------------------------------
    # Time
    # --------------------------------------------------------

    seed_start_time = time.time()

    # ========================================================
    # EPOCHS
    # ========================================================

    for epoch in range(EPOCHS):

        epoch_start_time = time.time()

        # ====================================================
        # TRAINING
        # ====================================================

        model.train()

        running_loss = 0.0

        correct = 0

        total = 0

        for images, labels in train_loader:

            images = images.to(
                device,
                non_blocking=True
            )

            labels = labels.float().unsqueeze(1)

            labels = labels.to(
                device,
                non_blocking=True
            )

            # ------------------------------------------------
            # Clear gradients
            # ------------------------------------------------

            optimizer.zero_grad(
                set_to_none=True
            )

            # ------------------------------------------------
            # Forward
            # ------------------------------------------------

            outputs = model(images)

            # ------------------------------------------------
            # Loss
            # ------------------------------------------------

            loss = criterion(
                outputs,
                labels
            )

            # ------------------------------------------------
            # Backpropagation
            # ------------------------------------------------

            loss.backward()

            optimizer.step()

            # ------------------------------------------------
            # Loss
            # ------------------------------------------------

            running_loss += loss.item()

            # ------------------------------------------------
            # Training predictions
            # ------------------------------------------------

            probs = torch.sigmoid(
                outputs
            )

            preds = (
                probs >= 0.5
            ).float()

            correct += (
                preds.squeeze(1) ==
                labels.squeeze(1)
            ).sum().item()

            total += labels.size(0)

        # ----------------------------------------------------
        # Training statistics
        # ----------------------------------------------------

        train_loss = (
            running_loss /
            len(train_loader)
        )

        train_acc = (
            correct / total
        ) * 100

        # ====================================================
        # VALIDATION
        # ====================================================

        model.eval()

        val_running_loss = 0.0

        val_correct = 0

        val_total = 0

        with torch.no_grad():

            for images, labels in val_loader:

                images = images.to(
                    device,
                    non_blocking=True
                )

                labels = labels.float().unsqueeze(1)

                labels = labels.to(
                    device,
                    non_blocking=True
                )

                outputs = model(images)

                loss = criterion(
                    outputs,
                    labels
                )

                val_running_loss += (
                    loss.item()
                )

                probs = torch.sigmoid(
                    outputs
                )

                preds = (
                    probs >= 0.5
                ).float()

                val_correct += (
                    preds.squeeze(1) ==
                    labels.squeeze(1)
                ).sum().item()

                val_total += (
                    labels.size(0)
                )

        # ----------------------------------------------------
        # Validation statistics
        # ----------------------------------------------------

        val_loss = (
            val_running_loss /
            len(val_loader)
        )

        val_acc = (
            val_correct /
            val_total
        ) * 100

        # ----------------------------------------------------
        # Scheduler
        # ----------------------------------------------------

        scheduler.step()

        # ----------------------------------------------------
        # Store history
        # ----------------------------------------------------

        history["train_loss"].append(
            train_loss
        )

        history["val_loss"].append(
            val_loss
        )

        history["train_acc"].append(
            train_acc
        )

        history["val_acc"].append(
            val_acc
        )

        # ====================================================
        # SAVE BEST MODEL IN MEMORY
        # ====================================================

        if val_loss < best_val_loss:

            best_val_loss = val_loss

            best_model_state = copy.deepcopy(
                model.state_dict()
            )

        # ----------------------------------------------------
        # Epoch time
        # ----------------------------------------------------

        epoch_time = (
            time.time() -
            epoch_start_time
        )

        print(
            f"\nSeed {seed} | "
            f"Epoch {epoch + 1}/{EPOCHS}"
        )

        print(
            f"Train Loss: {train_loss:.4f} | "
            f"Val Loss: {val_loss:.4f}"
        )

        print(
            f"Train Acc: {train_acc:.2f}% | "
            f"Val Acc: {val_acc:.2f}%"
        )

        print(
            f"Epoch Time: "
            f"{epoch_time / 60:.2f} minutes"
        )

    # ========================================================
    # RESTORE BEST MODEL
    # ========================================================

    model.load_state_dict(
        best_model_state
    )

    model = model.to(device)

    # ========================================================
    # SEED TIME
    # ========================================================

    seed_time = (
        time.time() -
        seed_start_time
    )

    print("\n")
    print("=" * 70)
    print(f"SEED {seed} TRAINING COMPLETE")
    print(
        f"Time taken: "
        f"{seed_time / 60:.2f} minutes"
    )
    print("=" * 70)

    # ========================================================
    # TRAINING / VALIDATION / TESTING PREDICTIONS
    # ========================================================

    print(
        f"\nCalculating final metrics "
        f"for Seed {seed}..."
    )

    train_y, train_pred, train_prob = (
        get_predictions(
            model,
            train_loader
        )
    )

    val_y, val_pred, val_prob = (
        get_predictions(
            model,
            val_loader
        )
    )

    test_y, test_pred, test_prob = (
        get_predictions(
            model,
            test_loader
        )
    )

    # ========================================================
    # METRICS
    # ========================================================

    train_metrics, train_cm = calculate_metrics(
        train_y,
        train_pred,
        train_prob
    )

    val_metrics, val_cm = calculate_metrics(
        val_y,
        val_pred,
        val_prob
    )

    test_metrics, test_cm = calculate_metrics(
        test_y,
        test_pred,
        test_prob
    )

    # ========================================================
    # ROC INFORMATION
    # ========================================================

    train_fpr, train_tpr, _ = roc_curve(
        train_y,
        train_prob
    )

    val_fpr, val_tpr, _ = roc_curve(
        val_y,
        val_prob
    )

    test_fpr, test_tpr, _ = roc_curve(
        test_y,
        test_prob
    )

    # ========================================================
    # PRINT SEED RESULT IMMEDIATELY
    # ========================================================

    print("\n")
    print("=" * 90)
    print(f"SEED {seed} - FINAL PERFORMANCE")
    print("=" * 90)

    seed_table = pd.DataFrame({

        "Metric": list(train_metrics.keys()),

        "Training": list(
            train_metrics.values()
        ),

        "Validation": list(
            val_metrics.values()
        ),

        "Testing": list(
            test_metrics.values()
        )
    })

    print(
        seed_table.to_string(
            index=False,
            float_format=lambda x:
            f"{x:.4f}"
        )
    )

    # ========================================================
    # PRINT CONFUSION MATRICES
    # ========================================================

    print(
        f"\nSeed {seed} - Training Confusion Matrix:"
    )

    print(train_cm)

    print(
        f"\nSeed {seed} - Validation Confusion Matrix:"
    )

    print(val_cm)

    print(
        f"\nSeed {seed} - Testing Confusion Matrix:"
    )

    print(test_cm)

    # ========================================================
    # RETURN EVERYTHING
    # ========================================================

    return {

        "seed": seed,

        "model_state": copy.deepcopy(
            model.state_dict()
        ),

        "history": history,

        "train_metrics": train_metrics,

        "val_metrics": val_metrics,

        "test_metrics": test_metrics,

        "train_cm": train_cm,

        "val_cm": val_cm,

        "test_cm": test_cm,

        "train_fpr": train_fpr,

        "train_tpr": train_tpr,

        "val_fpr": val_fpr,

        "val_tpr": val_tpr,

        "test_fpr": test_fpr,

        "test_tpr": test_tpr,

        "train_y": train_y,

        "train_pred": train_pred,

        "train_prob": train_prob,

        "val_y": val_y,

        "val_pred": val_pred,

        "val_prob": val_prob,

        "test_y": test_y,

        "test_pred": test_pred,

        "test_prob": test_prob,

        "time_seconds": seed_time
    }


# ============================================================
