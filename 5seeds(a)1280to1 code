def interpolate_mean_roc(
    fpr_list,
    tpr_list
):

    mean_fpr = np.linspace(
        0,
        1,
        1000
    )

    interpolated_tprs = []

    for fpr, tpr in zip(
        fpr_list,
        tpr_list
    ):

        interp_tpr = np.interp(
            mean_fpr,
            fpr,
            tpr
        )

        interp_tpr[0] = 0.0

        interpolated_tprs.append(
            interp_tpr
        )

    interpolated_tprs = np.array(
        interpolated_tprs
    )

    mean_tpr = np.mean(
        interpolated_tprs,
        axis=0
    )

    sd_tpr = np.std(
        interpolated_tprs,
        axis=0,
        ddof=1
    )

    mean_tpr[-1] = 1.0

    return (
        mean_fpr,
        mean_tpr,
        sd_tpr
    )


