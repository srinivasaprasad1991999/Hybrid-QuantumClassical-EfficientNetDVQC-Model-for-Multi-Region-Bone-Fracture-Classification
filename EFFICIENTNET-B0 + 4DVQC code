# 19. ADVANCED METRICS
# ============================================================

def calculate_advanced_metrics(cm):

    tn, fp, fn, tp = cm.ravel()

    total = (
        tn +
        fp +
        fn +
        tp
    )


    accuracy = (
        (tp + tn) /
        total *
        100
    )


    sensitivity = (

        tp /
        (tp + fn) *
        100

        if (tp + fn) > 0

        else 0
    )


    specificity = (

        tn /
        (tn + fp) *
        100

        if (tn + fp) > 0

        else 0
    )


    precision = (

        tp /
        (tp + fp) *
        100

        if (tp + fp) > 0

        else 0
    )


    f1 = (

        2 * tp /
        (
            2 * tp +
            fp +
            fn
        ) *
        100

        if (
            2 * tp +
            fp +
            fn
        ) > 0

        else 0
    )


    error_rate = (
        (fp + fn) /
        total *
        100
    )


    return {

        "Accuracy (%)":
            accuracy,

        "Sensitivity (%)":
            sensitivity,

        "Specificity (%)":
            specificity,

        "Precision (%)":
            precision,

        "F1-Score (%)":
            f1,

        "Error Rate (%)":
            error_rate
    }


# ============================================================
# 20. PREDICTION FUNCTION
# ============================================================

def get_preds_probs(
    model,
    loader
):

    model.eval()


    y_true = []

    y_prob = []

    y_pred = []


    with torch.no_grad():

        for x, y in loader:

            x = x.to(
                device,
                non_blocking=True
            )


            out = model(
                x
            ).squeeze(-1)


            # Probability
            probabilities = (
                out.detach()
                .cpu()
                .numpy()
            )


            # Prediction
            predictions = (
                out >= 0.5
            ).int().cpu().numpy()


            # True labels
            labels = (
                y.cpu().numpy()
            )


            y_true.extend(
                labels
            )

            y_prob.extend(
                probabilities
            )

            y_pred.extend(
                predictions
            )


    return (

        np.asarray(y_true),

        np.asarray(y_prob),

        np.asarray(y_pred)
    )


