# 16. HYBRID EFFICIENTNET-DVQC MODEL
# ============================================================

class HybridEfficientNet(nn.Module):

    def __init__(self):

        super().__init__()


        # ----------------------------------------------------
        # EfficientNet-B0
        # ----------------------------------------------------

        self.backbone = models.efficientnet_b0(

            weights=
            EfficientNet_B0_Weights.IMAGENET1K_V1

        )


        # EfficientNet-B0 feature dimension
        n_features = (
            self.backbone
            .classifier[1]
            .in_features
        )


        # Remove original classifier
        self.backbone.classifier = nn.Identity()


        # ----------------------------------------------------
        # Classical compression layer
        #
        # 1280 -> 4
        # ----------------------------------------------------

        self.cl_layer_1 = nn.Sequential(

            nn.Linear(
                n_features,
                N_QUBITS
            ),

            nn.Tanh()
        )


        # ----------------------------------------------------
        # Quantum layer
        # ----------------------------------------------------

        self.q_layer = (
            qml.qnn.TorchLayer(
                q_circuit,
                weight_shapes
            )
        )


        # ----------------------------------------------------
        # Classical output layer
        #
        # 4 -> 1
        # ----------------------------------------------------

        self.cl_layer_2 = nn.Linear(
            N_QUBITS,
            1
        )


        # ----------------------------------------------------
        # Sigmoid
        # ----------------------------------------------------

        self.sigmoid = nn.Sigmoid()


    def forward(self, x):

        # EfficientNet features
        x = self.backbone(x)


        # 1280 -> 4
        x = self.cl_layer_1(x)


        # Quantum circuit
        x = self.q_layer(x)


        # 4 -> 1
        x = self.cl_layer_2(x)


        # Probability
        x = self.sigmoid(x)


        return x


