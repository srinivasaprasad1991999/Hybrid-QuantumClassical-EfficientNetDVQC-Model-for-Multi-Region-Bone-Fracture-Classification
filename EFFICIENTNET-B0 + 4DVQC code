# 18. TRAIN ONE SEED
# ============================================================

def train_one_seed(seed):

    # --------------------------------------------------------
    # Set seed
    # --------------------------------------------------------

    set_seed(seed)


    # --------------------------------------------------------
    # Create NEW model
    # --------------------------------------------------------

    model = HybridEfficientNet().to(device)


    # --------------------------------------------------------
    # Loss
    # --------------------------------------------------------

    criterion = nn.BCELoss()


    # --------------------------------------------------------
    # NEW optimizer
    # --------------------------------------------------------

    optimizer = optim.AdamW(
        model.parameters(),
        lr=LEARNING_RATE
    )


    # --------------------------------------------------------
    # History
    # --------------------------------------------------------

    history = {

        "train_loss": [],

        "val_loss": [],

        "train_acc": [],

        "val_acc": []
    }


    # --------------------------------------------------------
    # Best validation loss
    # --------------------------------------------------------

    best_val_loss = float("inf")

    best_model_state = None


    # --------------------------------------------------------
    # Start timer
    # --------------------------------------------------------

    start_time = time.time()


    print("\n")
    print("=" * 70)

    print(
        f"STARTING DVQC TRAINING "
        f"FOR SEED {seed}"
    )

    print("=" * 70)


    # ========================================================
    # EPOCH LOOP
    # ========================================================

    for epoch in range(EPOCHS):


        # ====================================================
        # TRAINING
        # ====================================================

        model.train()

        train_loss = 0.0

        correct = 0

        total = 0


        loop = tqdm(

            train_loader,

            desc=
            f"Seed {seed} | "
            f"Epoch {epoch+1}/{EPOCHS}"
        )


        for inputs, labels in loop:

            inputs = inputs.to(
                device,
                non_blocking=True
            )

            labels = labels.to(
                device,
                non_blocking=True
            ).float()


            # ------------------------------------------------
            # Forward
            # ------------------------------------------------

            optimizer.zero_grad()

            outputs = model(
                inputs
            ).squeeze(-1)


            # ------------------------------------------------
            # Loss
            # ------------------------------------------------

            loss = criterion(
                outputs,
                labels
            )


            # ------------------------------------------------
            # Backpropagation
            # ------------------------------------------------

            loss.backward()

            optimizer.step()


            # ------------------------------------------------
            # Loss statistics
            # ------------------------------------------------

            train_loss += loss.item()


            # ------------------------------------------------
            # Accuracy
            # ------------------------------------------------

            predicted = (
                outputs >= 0.5
            ).float()


            total += labels.size(0)

            correct += (
                predicted == labels
            ).sum().item()


            loop.set_postfix(
                loss=loss.item()
            )


        # ----------------------------------------------------
        # Epoch training statistics
        # ----------------------------------------------------

        avg_train_loss = (
            train_loss /
            len(train_loader)
        )

        train_acc = (
            100.0 *
            correct /
            total
        )


        # ====================================================
        # VALIDATION
        # ====================================================

        model.eval()

        val_loss = 0.0

        val_correct = 0

        val_total = 0


        with torch.no_grad():

            for inputs, labels in val_loader:

                inputs = inputs.to(
                    device,
                    non_blocking=True
                )

                labels = labels.to(
                    device,
                    non_blocking=True
                ).float()


                outputs = model(
                    inputs
                ).squeeze(-1)


                loss = criterion(
                    outputs,
                    labels
                )


                val_loss += (
                    loss.item()
                )


                predicted = (
                    outputs >= 0.5
                ).float()


                val_total += (
                    labels.size(0)
                )


                val_correct += (
                    predicted == labels
                ).sum().item()


        # ----------------------------------------------------
        # Validation statistics
        # ----------------------------------------------------

        avg_val_loss = (
            val_loss /
            len(val_loader)
        )

        val_acc = (
            100.0 *
            val_correct /
            val_total
        )


        # ====================================================
        # SAVE BEST MODEL
        # ====================================================

        if (
            avg_val_loss <
            best_val_loss
        ):

            best_val_loss = (
                avg_val_loss
            )


            best_model_state = copy.deepcopy(
                model.state_dict()
            )


        # ====================================================
        # HISTORY
        # ====================================================

        history[
            "train_loss"
        ].append(
            avg_train_loss
        )

        history[
            "val_loss"
        ].append(
            avg_val_loss
        )

        history[
            "train_acc"
        ].append(
            train_acc
        )

        history[
            "val_acc"
        ].append(
            val_acc
        )


        print(

            f"Seed {seed} | "

            f"Epoch {epoch+1}/{EPOCHS} | "

            f"Train Loss: "
            f"{avg_train_loss:.4f} | "

            f"Val Loss: "
            f"{avg_val_loss:.4f} | "

            f"Train Acc: "
            f"{train_acc:.2f}% | "

            f"Val Acc: "
            f"{val_acc:.2f}%"
        )


    # ========================================================
    # RESTORE BEST MODEL
    # ========================================================

    if best_model_state is not None:

        model.load_state_dict(
            best_model_state
        )


    model = model.to(device)


    # ========================================================
    # TIME
    # ========================================================

    elapsed_time = (
        time.time() -
        start_time
    )


    print("\n")
    print(
        f"Seed {seed} completed "
        f"in "
        f"{elapsed_time / 60:.2f} minutes."
    )


    return model, history


