# 15. METRIC FUNCTION
# ============================================================

def calculate_metrics(
    y_true,
    y_pred,
    y_prob
):

    cm = confusion_matrix(
        y_true,
        y_pred,
        labels=[0, 1]
    )

    TN, FP, FN, TP = cm.ravel()


    # --------------------------------------------------------
    # Accuracy
    # --------------------------------------------------------

    accuracy = (
        (TP + TN) /
        (TP + TN + FP + FN)
    ) * 100


    # --------------------------------------------------------
    # Sensitivity
    # --------------------------------------------------------

    sensitivity = (
        TP / (TP + FN)
    ) * 100 if (TP + FN) > 0 else 0.0


    # --------------------------------------------------------
    # Specificity
    # --------------------------------------------------------

    specificity = (
        TN / (TN + FP)
    ) * 100 if (TN + FP) > 0 else 0.0


    # --------------------------------------------------------
    # Precision
    # --------------------------------------------------------

    precision = precision_score(
        y_true,
        y_pred,
        zero_division=0
    ) * 100


    # --------------------------------------------------------
    # F1
    # --------------------------------------------------------

    f1 = f1_score(
        y_true,
        y_pred,
        zero_division=0
    ) * 100


    # --------------------------------------------------------
    # Error Rate
    # --------------------------------------------------------

    error_rate = 100 - accuracy


    # --------------------------------------------------------
    # ROC-AUC
    # --------------------------------------------------------

    try:

        roc_auc = roc_auc_score(
            y_true,
            y_prob
        )

    except ValueError:

        roc_auc = np.nan


    metrics = {

        "Accuracy (%)": accuracy,

        "Sensitivity (%)": sensitivity,

        "Specificity (%)": specificity,

        "Precision (%)": precision,

        "F1-Score (%)": f1,

        "Error Rate (%)": error_rate,

        "ROC-AUC": roc_auc
    }


    return metrics, cm


# ============================================================
# 16. PREDICTION FUNCTION
# ============================================================

def get_predictions(
    model,
    loader
):

    model.eval()


    y_true = []

    y_pred = []

    y_prob = []


    with torch.no_grad():

        for images, labels in loader:

            images = images.to(
                device,
                non_blocking=True
            )


            # ------------------------------------------------
            # Model output = logits
            # ------------------------------------------------

            outputs = model(images)


            # ------------------------------------------------
            # Convert logits → probability
            # ------------------------------------------------

            probs = torch.sigmoid(
                outputs
            )


            # ------------------------------------------------
            # Probability → class
            # ------------------------------------------------

            preds = (
                probs >= 0.5
            ).long()


            y_true.extend(
                labels.cpu().numpy()
            )

            y_pred.extend(
                preds.cpu().numpy().flatten()
            )

            y_prob.extend(
                probs.cpu().numpy().flatten()
            )


    return (
        np.array(y_true),
        np.array(y_pred),
        np.array(y_prob)
    )


# ============================================================
# 17. TRAINING FUNCTION FOR ONE SEED
# ============================================================

def train_one_seed(seed):

    print("\n")
    print("=" * 80)
    print(f"STARTING TRAINING FOR SEED {seed}")
    print("=" * 80)


    # --------------------------------------------------------
    # Set seed
    # --------------------------------------------------------

    set_seed(seed)


    # --------------------------------------------------------
    # Create NEW model for this seed
    # --------------------------------------------------------

    model = EfficientNet_16().to(device)


    # --------------------------------------------------------
    # Loss
    # --------------------------------------------------------

    criterion = nn.BCEWithLogitsLoss()


    # --------------------------------------------------------
    # NEW optimizer
    # --------------------------------------------------------

    optimizer = optim.Adam(
        model.parameters(),
        lr=LEARNING_RATE
    )


    # --------------------------------------------------------
    # NEW scheduler for each seed
    # --------------------------------------------------------

    scheduler = torch.optim.lr_scheduler.StepLR(
        optimizer,
        step_size=3,
        gamma=0.1
    )


    # --------------------------------------------------------
    # History
    # --------------------------------------------------------

    history = {

        "train_loss": [],

        "val_loss": [],

        "train_acc": [],

        "val_acc": []
    }


    # --------------------------------------------------------
    # Best model
    # --------------------------------------------------------

    best_val_loss = float("inf")

    best_model_state = None


    # --------------------------------------------------------
    # Seed start time
    # --------------------------------------------------------

    seed_start_time = time.time()


    # ========================================================
    # EPOCH LOOP
    # ========================================================

    for epoch in range(EPOCHS):


        # ====================================================
        # TRAINING
        # ====================================================

        model.train()


        running_loss = 0.0

        correct = 0

        total = 0


        for images, labels in train_loader:

            images = images.to(
                device,
                non_blocking=True
            )

            labels = labels.float().unsqueeze(1).to(
                device,
                non_blocking=True
            )


            # ------------------------------------------------
            # Clear gradients
            # ------------------------------------------------

            optimizer.zero_grad(
                set_to_none=True
            )


            # ------------------------------------------------
            # Forward
            # ------------------------------------------------

            outputs = model(images)


            # ------------------------------------------------
            # Loss
            # ------------------------------------------------

            loss = criterion(
                outputs,
                labels
            )


            # ------------------------------------------------
            # Backpropagation
            # ------------------------------------------------

            loss.backward()


            optimizer.step()


            running_loss += loss.item()


            # ------------------------------------------------
            # Training accuracy
            # ------------------------------------------------

            probs = torch.sigmoid(
                outputs
            )

            preds = (
                probs >= 0.5
            ).float()


            correct += (
                preds == labels
            ).sum().item()


            total += labels.size(0)


        # ----------------------------------------------------
        # Epoch training results
        # ----------------------------------------------------

        train_loss = (
            running_loss /
            len(train_loader)
        )


        train_acc = (
            correct /
            total
        ) * 100


        # ====================================================
        # VALIDATION
        # ====================================================

        model.eval()


        val_running_loss = 0.0

        val_correct = 0

        val_total = 0


        with torch.no_grad():

            for images, labels in val_loader:

                images = images.to(
                    device,
                    non_blocking=True
                )

                labels = labels.float().unsqueeze(1).to(
                    device,
                    non_blocking=True
                )


                outputs = model(images)


                loss = criterion(
                    outputs,
                    labels
                )


                val_running_loss += (
                    loss.item()
                )


                probs = torch.sigmoid(
                    outputs
                )


                preds = (
                    probs >= 0.5
                ).float()


                val_correct += (
                    preds == labels
                ).sum().item()


                val_total += labels.size(0)


        # ----------------------------------------------------
        # Validation results
        # ----------------------------------------------------

        val_loss = (
            val_running_loss /
            len(val_loader)
        )


        val_acc = (
            val_correct /
            val_total
        ) * 100


        # ----------------------------------------------------
        # Scheduler
        # ----------------------------------------------------

        scheduler.step()


        # ====================================================
        # SAVE BEST MODEL
        # ====================================================

        if val_loss < best_val_loss:

            best_val_loss = val_loss


            best_model_state = copy.deepcopy(
                model.state_dict()
            )


            print(
                f"Checkpoint saved: "
                f"Seed {seed}, "
                f"Epoch {epoch + 1}"
            )


        # ====================================================
        # SAVE HISTORY
        # ====================================================

        history["train_loss"].append(
            train_loss
        )

        history["val_loss"].append(
            val_loss
        )

        history["train_acc"].append(
            train_acc
        )

        history["val_acc"].append(
            val_acc
        )


        # ====================================================
        # PRINT EPOCH RESULTS
        # ====================================================

        print(

            f"\nSeed {seed} | "
            f"Epoch {epoch + 1}/{EPOCHS} | "

            f"Train Loss: {train_loss:.4f} | "

            f"Val Loss: {val_loss:.4f} | "

            f"Train Acc: {train_acc:.2f}% | "

            f"Val Acc: {val_acc:.2f}%"
        )


    # ========================================================
    # RESTORE BEST MODEL
    # ========================================================

    if best_model_state is None:

        raise RuntimeError(
            f"No best model was saved for seed {seed}."
        )


    model.load_state_dict(
        best_model_state
    )


    model = model.to(device)


    # ========================================================
    # SEED TIME
    # ========================================================

    seed_time = (
        time.time() -
        seed_start_time
    )


    # ========================================================
    # SAVE SEED MODEL
    # ========================================================

    seed_model_path = (
        f"/content/best_model_seed_{seed}.pth"
    )


    torch.save(
        model.state_dict(),
        seed_model_path
    )


    print("\n")
    print("=" * 80)
    print(f"SEED {seed} TRAINING COMPLETE")
    print(
        f"Time taken: "
        f"{seed_time / 60:.2f} minutes"
    )
    print(
        f"Best Validation Loss: "
        f"{best_val_loss:.6f}"
    )
    print(
        f"Model saved: "
        f"{seed_model_path}"
    )
    print("=" * 80)


    # ========================================================
    # EVALUATION FOR THIS SEED
    # ========================================================

    print(
        f"\nEvaluating Seed {seed} "
        f"on Training / Validation / Testing..."
    )


    # --------------------------------------------------------
    # Training
    # --------------------------------------------------------

    train_y, train_pred, train_prob = (
        get_predictions(
            model,
            train_loader
        )
    )


    # --------------------------------------------------------
    # Validation
    # --------------------------------------------------------

    val_y, val_pred, val_prob = (
        get_predictions(
            model,
            val_loader
        )
    )


    # --------------------------------------------------------
    # Testing
    # --------------------------------------------------------

    test_y, test_pred, test_prob = (
        get_predictions(
            model,
            test_loader
        )
    )


    # ========================================================
    # CALCULATE METRICS
    # ========================================================

    train_metrics, train_cm = calculate_metrics(
        train_y,
        train_pred,
        train_prob
    )


    val_metrics, val_cm = calculate_metrics(
        val_y,
        val_pred,
        val_prob
    )


    test_metrics, test_cm = calculate_metrics(
        test_y,
        test_pred,
        test_prob
    )


    # ========================================================
    # PRINT METRICS FOR THIS SEED
    # ========================================================

    print("\n")
    print("=" * 90)
    print(f"SEED {seed} PERFORMANCE")
    print("=" * 90)


    seed_metrics_df = pd.DataFrame({

        "Metric": list(train_metrics.keys()),

        "Training": list(
            train_metrics.values()
        ),

        "Validation": list(
            val_metrics.values()
        ),

        "Testing": list(
            test_metrics.values()
        )
    })


    print(
        seed_metrics_df.to_string(
            index=False
        )
    )


    # ========================================================
    # RETURN EVERYTHING
    # ========================================================

    return {

        "seed": seed,

        "model": model,

        "history": history,

        "train_metrics": train_metrics,

        "val_metrics": val_metrics,

        "test_metrics": test_metrics,

        "train_cm": train_cm,

        "val_cm": val_cm,

        "test_cm": test_cm,

        "train_y": train_y,

        "train_pred": train_pred,

        "train_prob": train_prob,

        "val_y": val_y,

        "val_pred": val_pred,

        "val_prob": val_prob,

        "test_y": test_y,

        "test_pred": test_pred,

        "test_prob": test_prob,

        "time_minutes": seed_time,

        "best_val_loss": best_val_loss,

        "model_path": seed_model_path
    }


