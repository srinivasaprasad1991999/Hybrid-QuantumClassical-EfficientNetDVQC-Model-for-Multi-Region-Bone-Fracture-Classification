# ============================================================
# 30. ROC CURVES
#     TRAINING + VALIDATION + TESTING
#     MEAN ± SD
# ============================================================

def calculate_mean_roc(
    results,
    dataset_name,
    num_points=1000
):

    mean_fpr = np.linspace(
        0,
        1,
        num_points
    )


    interpolated_tprs = []

    auc_values = []


    for result in results:

        if dataset_name == "Training":

            y_true = result["train_y"]

            y_prob = result["train_prob"]

        elif dataset_name == "Validation":

            y_true = result["val_y"]

            y_prob = result["val_prob"]

        else:

            y_true = result["test_y"]

            y_prob = result["test_prob"]


        fpr, tpr, _ = roc_curve(
            y_true,
            y_prob
        )


        auc_value = roc_auc_score(
            y_true,
            y_prob
        )


        auc_values.append(
            auc_value
        )


        interp_tpr = np.interp(
            mean_fpr,
            fpr,
            tpr
        )


        interp_tpr[0] = 0.0

        interp_tpr[-1] = 1.0


        interpolated_tprs.append(
            interp_tpr
        )


    interpolated_tprs = np.array(
        interpolated_tprs
    )


    mean_tpr = np.mean(
        interpolated_tprs,
        axis=0
    )


    sd_tpr = np.std(
        interpolated_tprs,
        axis=0,
        ddof=1
    )


    mean_auc = np.mean(
        auc_values
    )


    sd_auc = np.std(
        auc_values,
        ddof=1
    )


    return (
        mean_fpr,
        mean_tpr,
        sd_tpr,
        mean_auc,
        sd_auc
    )


