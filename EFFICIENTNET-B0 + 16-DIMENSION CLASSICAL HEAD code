# 13. MODEL
#
# EfficientNet-B0
#      ↓
# 1280
#      ↓
# Linear(1280 → 16)
#      ↓
# Tanh
#      ↓
# Linear(16 → 1)
#      ↓
# Sigmoid during evaluation
# ============================================================

class EfficientNet_16(nn.Module):

    def __init__(self):

        super(EfficientNet_16, self).__init__()


        # ----------------------------------------------------
        # EfficientNet-B0 backbone
        # ----------------------------------------------------

        self.backbone = models.efficientnet_b0(
            weights=EfficientNet_B0_Weights.DEFAULT
        )


        # ----------------------------------------------------
        # Remove original classifier
        # ----------------------------------------------------

        self.backbone.classifier = nn.Identity()


        # ----------------------------------------------------
        # 1280 → 16
        # ----------------------------------------------------

        self.fc1 = nn.Linear(
            1280,
            16
        )


        # ----------------------------------------------------
        # Tanh
        # ----------------------------------------------------

        self.tanh = nn.Tanh()


        # ----------------------------------------------------
        # 16 → 1
        # ----------------------------------------------------

        self.fc2 = nn.Linear(
            16,
            1
        )


    def forward(self, x):

        # EfficientNet-B0
        x = self.backbone(x)


        # 1280 → 16
        x = self.fc1(x)


        # Tanh
        x = self.tanh(x)


        # 16 → 1
        x = self.fc2(x)


        return x


